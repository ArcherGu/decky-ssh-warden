{
  "name": "decky-ssh-warden",
  "version": "0.1.0",
  "description": "SSH Warden: manage the Steam Deck's SSH service from Game Mode",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "check:i18n": "${PYTHON:-python3} scripts/check_i18n.py",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "node --test \"tests/frontend/*.test.ts\"",
    "test:backend": "PYTHONPATH=py_modules ${PYTHON:-python3} -m unittest discover -s tests/backend",
    "package": "pnpm build && bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcherGu/decky-ssh-warden.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ssh"
  ],
  "author": "ArcherGu",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
